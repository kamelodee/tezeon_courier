{
  "expo": {
    "name": "Tezeon Driver",
    "slug": "tezeon-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "tezeon-driver",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.tezeon.driver",
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_ANDROID_GOOGLE_MAPS_API_KEY"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tezeon.driver",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_GOOGLE_MAPS_API_KEY"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "Tezeon Courier needs your location to show you nearby delivery jobs and provide navigation to pickup and delivery points.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tezeon Courier needs background location access to keep customers updated on their delivery status and ensure you receive nearby job notifications even when the app is in the background.",
        "NSLocationAlwaysUsageDescription": "Background location is needed to track deliveries and update customers in real-time."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "25822230-72fb-4dc2-8160-0f88581750ff"
      }
    },
    "owner": "kamilo",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tezeon Driver to use your location even when you are not using the app to track deliveries and receive nearby jobs.",
          "locationAlwaysPermission": "Allow Tezeon Driver to use your location in the background.",
          "locationWhenInUsePermission": "Allow Tezeon Driver to use your location while using the app.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}